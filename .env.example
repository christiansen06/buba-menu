# Copiar este archivo como .env.local y completar con los datos del proyecto.
# Supabase → Settings → API Keys (clave "Publishable") y Settings → Data API (Project URL).
# Estas dos son públicas: viajan dentro de la app. Lo que las hace seguras es
# el RLS de Supabase. La clave "Secret" NO va acá ni en ningún lado del front.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=sb_publishable_XXXXXXXXXXXX
